{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biblioteca-nova-alexandria",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-21",
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*","/admin","/admin/*"]},
  "d1_databases": [{"binding":"DB","database_name":"bna-db","database_id":"57711525-50a9-4f9e-b9b3-f941f9f4787b","migrations_dir":"migrations"}],
  "durable_objects": {"bindings":[{"name":"ROOM_SYNC","class_name":"RoomSync"}]},
  "migrations": [{"tag":"bna-v1","new_sqlite_classes":["RoomSync"]}],
  "observability": {"enabled":true}
}